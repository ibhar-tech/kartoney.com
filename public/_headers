# Port of vercel.json "headers".
#
# Cloudflare APPENDS headers from every matching rule rather than letting the
# most specific one win, so a bare override of Cache-Control below the catch-all
# yields "max-age=600, ..., max-age=31536000" in one field — undefined per
# RFC 9111, and browsers take the first value. Each override therefore unsets
# Cache-Control with `!` before setting its own. Verify with:
#   curl -sI https://kartoney.com/css/style.css | grep -i cache-control
# exactly one max-age must come back.

/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xsl
  ! Cache-Control
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=86400

/*.apk
  ! Cache-Control
  Content-Type: application/vnd.android.package-archive
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex

/app-ads.txt
  ! Cache-Control
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sw.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
